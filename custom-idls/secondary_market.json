    {
      "name": "createMarket",
      "docs": [
        "Allows the event organizer of the given event id to create a new secondary market",
        "",
        "# Arguments",
        "",
        "* `ctx` - The Anchor context holding the accounts",
        "* `event_id` - The event id for which the secondary market is created for",
        "* `organizer_resale_fee` - The percentage of the resale price the event organizer will collect",
        "* `resale_cap` - The max price a ticket can be sold on the secondary market. That will be",
        "(ticket_matadata.price_sold * (10_000 + resale_cap)) / 10_000"
      ],
      "accounts": [
        {
          "name": "state",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "market",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "event",
          "isMut": false,
          "isSigner": false,
          "docs": [
            "Constraints will be checked in the processor fn"
          ]
        },
        {
          "name": "eventOrganizer",
          "isMut": true,
          "isSigner": true,
          "docs": [
            "This is the user that created the event earlier",
            "event_organizer.key() == event.event_organizer will be checked in the processor"
          ]
        },
        {
          "name": "systemProgram",
          "isMut": false,
          "isSigner": false
        },
        {
          "name": "rent",
          "isMut": false,
          "isSigner": false
        }
      ],
      "args": [
        {
          "name": "eventId",
          "type": {
            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "organizerResaleFee",
          "type": "u16"
        },
        {
          "name": "resaleCap",
          "type": "u16"
        }
      ]
    },
    {
      "name": "createSellListing",
      "docs": [
        "Allows the ticket owner to list the ticket for sale",
        "",
        "# Arguments",
        "",
        "* `ctx` - The Anchor context holding the accounts",
        "* `event_id` - The event id for which the secondary market is created for",
        "* `_ticket_nft` - The pubic key of the ticket NFT Mint account. The processor will have to check that it belongs to the",
        "signer of this tx",
        "* `ask_price` - The  price a ticket will be sold. It must be",
        "lower than (ticket_matadata.price_sold * (10_000 + resale_cap)) / 10_000"
      ],
      "accounts": [
        {
