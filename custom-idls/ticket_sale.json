  "name": "ticket_sale",
  "instructions": [
    {
      "name": "initialize",
      "docs": [
        "Initializes the state i.e. instance of a given program",
        "",
        "# Arguments",
        "",
        "* `ctx` - The Anchor context holding the accounts",
        "* `treasury` - The ticketland.io treasury address"
      ],
      "accounts": [
        {
          "name": "state",
          "isMut": true,
          "isSigner": true
        },
        {
          "name": "cpiAuthority",
          "isMut": true,
          "isSigner": false
        },
