          "isSigner": false,
          "docs": [
            "We use AccountInfo instead of Account<'info, Mint> because the latter will check if the",
            "account is initialized. However, this account will be initialized in the Ticket NFT program after",
            "the CPI is done."
          ]
        },
        {
          "name": "nftAuthority",
          "isMut": false,
