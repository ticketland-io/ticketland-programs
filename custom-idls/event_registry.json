          "isMut": true,
          "isSigner": false
        },
        {
          "name": "organizerEventNftAta",
          "isMut": true,
          "isSigner": false,
          "docs": [
            "This will be under the event organizer's control. However, the metadata will be controlled by the event_nft_authority"
          ]
        },
        {
          "name": "metadata",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "masterEdition",
          "isMut": true,
          "isSigner": false
        },
        {
          "name": "eventOrganizer",
          "isMut": true,
          "isSigner": true
        },
        {
